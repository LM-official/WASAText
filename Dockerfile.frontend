# Build the Vue application with Node 20; the builder is not the final image.
FROM node:20-alpine AS builder

# Create /app and use it for subsequent build commands and relative COPY paths.
WORKDIR /app

# Enable Yarn through Corepack and activate the version pinned by the project.
RUN corepack enable \
    && corepack prepare yarn@4.5.0 --activate

# Copy dependency manifests before application sources so source edits can reuse the install layer.
COPY webui/package.json webui/yarn.lock webui/.yarnrc.yml ./
# Include the Yarn release referenced by .yarnrc.yml; .dockerignore excludes local cache/state.
COPY webui/.yarn/ .yarn/
# Download dependencies and populate the cache without allowing yarn.lock to change.
RUN yarn install --immutable

# Add the frontend sources; local node_modules and dist are excluded by .dockerignore.
COPY webui/ .
# Build /app/dist; the script reuses the dependencies installed above.
RUN yarn run build-prod

# Serve the built files with nginx; Node and build dependencies stay in the builder stage.
FROM nginx:stable-alpine AS runtime

# Remove the default nginx website before installing this application's files.
RUN rm -rf /usr/share/nginx/html/*
# Copy only the production bundle into nginx's document root.
COPY --from=builder /app/dist /usr/share/nginx/html

# Document nginx's listening port; Compose publishes it on host port 5173.
EXPOSE 80

# Keep nginx in the foreground so it remains the container's main process.
CMD ["nginx", "-g", "daemon off;"]
