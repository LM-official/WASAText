# Compile the API with Go 1.22 on Debian Bookworm; this is the temporary builder stage.
FROM golang:1.22-bookworm AS builder

# Create /src and use it as the working directory for copying and compiling the project.
WORKDIR /src

# Install the C compiler and headers required by go-sqlite3, then remove package index files.
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy the repository sources and vendor/ after .dockerignore filters out local data and artifacts.
COPY . .

# Enable CGO for SQLite and use vendored dependencies; write the executable to /app/webapi.
RUN CGO_ENABLED=1 go build -mod=vendor -o /app/webapi ./cmd/webapi

# Use a smaller runtime with the same Debian release for compatibility with the CGO binary.
FROM debian:bookworm-slim AS runtime

# Run the server from /app; Go defaults to /tmp for writable storage.
WORKDIR /app

# Copy the compiled server without including the Go compiler or repository sources.
COPY --from=builder /app/webapi ./
# Ship the default user/group avatar; COPY also creates its parent directories.
# Docker copies it into a fresh photo volume when Compose first mounts that volume here.
COPY db/photos/00000000-0000-4000-8000-000000000000 /app/db/photos/00000000-0000-4000-8000-000000000000

# Document the API port; Compose publishes it on host port 3000.
EXPOSE 3000

# Start the API directly so it receives stop signals; Compose supplies its CFG_ settings.
CMD ["/app/webapi"]
